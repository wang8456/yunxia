      "root": "./data/files",
      "enabled": true
    },
    {
      "id": "pc",
      "name": "电脑 · dufs",
      "subtitle": "局域网里的电脑共享目录（需要 dufs）",
      "kind": "dufs",
      "base": "http://192.168.1.10:5000",
      "user": "",
      "password": "",
      "root": "/",
      "enabled": false
    },
    {
      "id": "cd2",
      "name": "CloudDrive2 · WebDAV",
      "subtitle": "经 CloudDrive2 的 WebDAV 挂载（115 等网盘）",
      "kind": "webdav",
      "base": "http://192.168.1.10:19798/dav",
      "user": "",
      "password": "",
      "root": "/",
      "enabled": false
    }
  ],
  "chat": {
    "enabled": false,
    "base": "https://api.deepseek.com/v1",
    "api_key": "",
    "model": "deepseek-chat",
    "system": "你是一个简洁、直接的中文助手。",
    "max_turns": 12,
    "timeout": 120
  }
}
